# Production configuration for docker-compose.prod.yml.
#
# Generate one with fresh secrets instead of editing this by hand:
#   ./scripts/gen-env.sh attendly.example.com you@example.com
#
# Never commit the real .env.production: it holds the database password and the
# CSRF secret. Keep a copy in a password manager or AWS Secrets Manager.

# The hostname browsers will use. Caddy asks Let's Encrypt for a certificate for
# exactly this name, so it must already resolve to this server before the first
# deploy.
DOMAIN=attendly.example.com
# Address Let's Encrypt sends expiry warnings to.
ACME_EMAIL=you@example.com

# Public origin including the scheme. Must match DOMAIN (add the port if you
# override HTTPS_PORT). The API rejects mutations whose Origin header differs.
WEB_ORIGIN=https://attendly.example.com

# Host ports Caddy binds. Leave at 80/443 in production.
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=attendly
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=attendly

# At least 32 random characters; the API refuses to start in production without
# a strong, non-placeholder value.
CSRF_SECRET=change-me-to-a-32-character-random-csrf-secret

# true behind HTTPS (cookies are only sent over TLS), false only for plain-HTTP
# local development.
COOKIE_SECURE=true
NODE_ENV=production

# Image tag for the running release. scripts/deploy.sh rewrites this line on
# every release, and scripts/rollback.sh points it back at an earlier build.
RELEASE=local

# Bootstrap teacher, used only by the opt-in "admin" profile:
#   docker compose -f docker-compose.prod.yml --env-file .env.production \
#     --profile admin run --rm create-teacher
TEACHER_NAME=
TEACHER_EMAIL=
TEACHER_PASSWORD=
